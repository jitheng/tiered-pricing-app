{
    "buildCommand": "prisma generate && rm -rf build && npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "framework": "remix",
    "regions": ["iad1"],
    "env": {
          "NODE_ENV": "production"
    },
    "build": {
          "env": {
                  "ENABLE_EXPERIMENTAL_COREPACK": "1",
                  "REMIX_SERVER_MODULE_FORMAT": "esm"
          }
    }
}
