{%- assign tp_product = block.settings.product -%}
<div
  class="tiered-pricing"
  data-tiered-pricing
  data-product-id="{{ tp_product.id | default: product.id }}"
  data-proxy="/apps/tiered-pricing/pricing-table"
  style="--tp-accent: {{ block.settings.accent_color }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="tiered-pricing__heading">{{ block.settings.heading }}</p>
  {%- endif -%}
  <div class="tiered-pricing__body" aria-live="polite" hidden></div>
</div>

{% schema %}
{
  "name": "Pricing table",
  "target": "section",
  "stylesheet": "pricing-table.css",
  "javascript": "pricing-table.js",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Volume pricing"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
