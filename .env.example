# ── Shopify App credentials ──────────────────────────────────────────────────
# Get these from your Shopify Partners dashboard → Apps → [Your App] → App setup
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Your app's public URL
# Development:  your ngrok URL  (e.g. https://abc123.ngrok-free.app)
# Production:   your Fly.io URL (e.g. https://tiered-pricing.fly.dev)
SHOPIFY_APP_URL=https://your-app-url.fly.dev

# OAuth scopes — must match shopify.app.toml [access_scopes]
SCOPES=read_all_orders,read_customers,read_discounts,read_orders,read_products,write_discounts

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL — database connection used by the app (serverless runtime).
#   Neon: use the POOLED host (contains "-pooler") and append
#   `pgbouncer=true&connection_limit=1`:
#     • pgbouncer=true     — disables prepared statements over PgBouncer
#     • connection_limit=1 — one connection per serverless instance; lets Neon's
#       pooler do the pooling. Prevents the connection-pool timeouts that
#       surfaced as the 2026-11 prod incident ("session table does not exist").
#   Also disable/lengthen Neon compute auto-suspend so cold starts don't trip
#   the pool timeout. Example:
#   postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@localhost:5432/tiered_pricing

# ── Optional ─────────────────────────────────────────────────────────────────
# SHOP_CUSTOM_DOMAIN=your-dev-store.myshopify.com
