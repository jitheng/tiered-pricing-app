# ── Shopify App credentials ──────────────────────────────────────────────────
# Get these from your Shopify Partners dashboard → Apps → [Your App] → App setup
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Your app's public URL
# Development:  your ngrok URL  (e.g. https://abc123.ngrok-free.app)
# Production:   your Fly.io URL (e.g. https://tiered-pricing.fly.dev)
SHOPIFY_APP_URL=https://your-app-url.fly.dev

# OAuth scopes — must match shopify.app.toml [access_scopes]
SCOPES=read_all_orders,read_customers,read_discounts,read_orders,read_products,write_discounts

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL — pooled connection used by the app at runtime (serverless).
#   Neon: use the POOLED host (contains "-pooler") and append `pgbouncer=true`
#   so Prisma disables prepared statements over PgBouncer, e.g.:
#   postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/tiered_pricing

# DIRECT_URL — direct (NON-pooled) connection used only for `prisma migrate
# deploy`/`generate` (build time). Required by prisma/schema.prisma (no fallback).
#   Neon: same credentials/db but the DIRECT host (WITHOUT "-pooler"), e.g.:
#   postgresql://user:pw@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# For local dev you may set it to the same value as DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/tiered_pricing

# ── Optional ─────────────────────────────────────────────────────────────────
# SHOP_CUSTOM_DOMAIN=your-dev-store.myshopify.com
