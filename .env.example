# ── Shopify App credentials ──────────────────────────────────────────────────
# Get these from your Shopify Partners dashboard → Apps → [Your App] → App setup
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Your app's public URL
# Development:  your ngrok URL  (e.g. https://abc123.ngrok-free.app)
# Production:   your Fly.io URL (e.g. https://tiered-pricing.fly.dev)
SHOPIFY_APP_URL=https://your-app-url.fly.dev

# OAuth scopes — must match shopify.app.toml [access_scopes]
SCOPES=read_all_orders,read_customers,read_discounts,read_orders,read_products,write_discounts

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL — database connection used by the app (serverless runtime).
#   Neon: use the POOLED host (contains "-pooler") and append
#   `pgbouncer=true&connection_limit=1`:
#     • pgbouncer=true     — disables prepared statements over PgBouncer
#     • connection_limit=1 — one connection per serverless instance; lets Neon's
#       pooler do the pooling. Prevents the connection-pool timeouts that
#       surfaced as the 2026-11 prod incident ("session table does not exist").
#   Also disable/lengthen Neon compute auto-suspend so cold starts don't trip
#   the pool timeout. Example:
#   postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@localhost:5432/tiered_pricing

# ── Shopify IP allowlist / static egress (Fly.io + squid) ────────────────────
# SHOPIFY_EGRESS_PROXY_URL — route all outbound `fetch` (Shopify Admin API
#   calls) through our self-hosted static-IP squid proxy (infra/egress-proxy/,
#   on Fly.io), so requests originate from a fixed IP you can allowlist in the
#   Shopify Dev Dashboard (API access → IP allowlist). Required because Vercel
#   serverless egress IPs are not enumerable and this team is not on Vercel
#   Enterprise (no native static egress).
#   Value host = the Fly INGRESS IPv4 (app → proxy); the port is 3128. Use the
#   https:// scheme — the proxy terminates TLS (stunnel), so the proxy
#   connection incl. the Proxy-Authorization header is encrypted:
#     SHOPIFY_EGRESS_PROXY_URL=https://tiered:SECRET@109.105.219.26:3128
#   BUT allowlist the Fly app-scoped EGRESS IPv4 (209.71.126.12) in Shopify — Fly
#   splits ingress vs egress. See docs/ip-allowlist-runbook.md. Leave unset to
#   disable (default — no proxying). DB traffic (Prisma → Neon) is TCP, not
#   fetch, so it's never proxied.
#   NOTE: contains credentials — set in Vercel env (Sensitive), never commit it.
# SHOPIFY_EGRESS_PROXY_URL=https://tiered:SECRET@109.105.219.26:3128
#
# SHOPIFY_EGRESS_PROXY_CA — PEM of the proxy's self-signed TLS cert, pinned when
#   connecting to an https:// proxy (the public cert is at
#   infra/egress-proxy/proxy-cert.pem). Literal "\n" are normalised to newlines,
#   so it can be one env line. Required for the https:// proxy above.
# SHOPIFY_EGRESS_PROXY_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# ── Optional ─────────────────────────────────────────────────────────────────
# SHOP_CUSTOM_DOMAIN=your-dev-store.myshopify.com
